# Referensi variabel, bukan secret dan bukan file yang otomatis dimuat Memona.
# Bootstrap pertama: masukkan password >=16 karakter melalui prompt tersembunyi.
# Jangan menyimpan password sebenarnya di file ini atau source control.
MEMONA_ADMIN_PASSWORD=

# Hanya untuk proses klien OpenCode/Hermes; dibuat melalui dashboard Memona.
# Gunakan key berbeda untuk setiap harness. Jangan kirim key ke log atau chat.
MEMONA_API_KEY=
